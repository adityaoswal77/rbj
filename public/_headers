# Cloudflare Workers Static Assets header rules.
# Authored here because `next build` regenerates out/ on every build; Next copies
# public/ into the export, so this lands at out/_headers where Cloudflare reads it.
# Rules: pattern at column 0, headers indented. Repeating a header name across
# matching blocks COMMA-JOINS the values — so never set Cache-Control under /*.
#
# static.cloudflareinsights.com is Cloudflare Web Analytics, which the dashboard
# injects into the HTML; without it the CSP blocks the beacon and nothing is
# counted. Its reports go to this site's own /cdn-cgi/rum, covered by 'self'.
# HSTS has no includeSubDomains and no preload, so it only ever affects this
# one hostname and can be walked back by lowering max-age.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://maps.google.com https://www.google.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Next content-hashes every filename under here, so it can never go stale.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The share image, generated by app/opengraph-image.tsx. The export writes it
# without a file extension, so without this it is served as a generic binary
# and WhatsApp / Facebook may refuse to show it.
/opengraph-image
  Content-Type: image/png

# Byproducts of the static export that are reachable, return 200, and would
# otherwise be indexable duplicates of the page: the RSC payloads, and two
# copies of the 404 page that answer 200 at their own URLs (a soft 404).
# noindex rather than a robots.txt Disallow, so crawlers can actually read it.
/index.txt
  X-Robots-Tag: noindex

/__next.*
  X-Robots-Tag: noindex

/_not-found/*
  X-Robots-Tag: noindex

/404/*
  X-Robots-Tag: noindex
