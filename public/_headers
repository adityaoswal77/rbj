# Cloudflare Workers Static Assets header rules.
# Authored here because `next build` regenerates out/ on every build; Next copies
# public/ into the export, so this lands at out/_headers where Cloudflare reads it.
# Rules: pattern at column 0, headers indented. Repeating a header name across
# matching blocks COMMA-JOINS the values — so never set Cache-Control under /*.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://maps.google.com https://www.google.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Next content-hashes every filename under here, so it can never go stale.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
